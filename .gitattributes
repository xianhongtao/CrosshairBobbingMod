# Auto-detect text files and normalize to LF
* text=auto

# Java / source always LF
*.java text eol=lf
*.gradle text eol=lf
*.groovy text eol=lf
*.properties text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.mcmeta text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.editorconfig text eol=lf
.gitattributes text eol=lf

# Windows batch scripts must stay CRLF
*.bat text eol=crlf

# Binaries
*.jar binary
*.png binary
*.jpg binary
*.webp binary
*.class binary
